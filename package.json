{
  "name": "guitar-learn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:audio": "node --experimental-strip-types scripts/check-audio.ts",
    "ios:bundle": "node scripts/build-ios-detector.mjs",
    "ios:check": "node scripts/build-ios-detector.mjs --check && node --test ios/Tests/detector.test.mjs && bash ios/check-native.sh",
    "lint": "oxlint src tests scripts vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@kretoffer/guitar-audio-kit": "^0.0.2",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
