page { background: #f4f6fb; color: #182138; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 16px; line-height: 1.65; }
view, button { box-sizing: border-box; }
.page { padding: 24px 18px calc(28px + env(safe-area-inset-bottom)); }
.eyebrow { color: #254dff; font-size: 12px; letter-spacing: 2px; font-weight: 600; }
.title { font-size: 29px; line-height: 1.3; font-weight: 700; margin: 8px 0 12px; }
.subtitle { color: #59677e; font-size: 15px; }
.h2 { font-size: 20px; font-weight: 600; margin: 22px 0 12px; }
.h3 { font-size: 17px; font-weight: 600; margin-bottom: 8px; }
.muted { color: #59677e; font-size: 14px; }
.small { font-size: 12px; }
.paragraph { display: block; margin: 12px 0; }
.panel { background: #fff; border: 1px solid #dde3ef; border-radius: 16px; padding: 18px; margin: 16px 0; }
.hero { background: #e7edff; border-color: #d0dafe; }
.row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
.spread { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.gap { margin-top: 16px; }
.badge { display: inline-block; font-size: 12px; color: #254dff; background: #e7edff; border-radius: 5px; padding: 2px 7px; }
button { font-size: 15px; line-height: 1.5; padding: 12px 14px; margin: 0; border-radius: 10px; background: #e9edf5; color: #26334a; min-height: 44px; }
button::after { border: none; }
button.primary { background: #254dff; color: white; font-weight: 600; }
button.secondary { background: white; border: 1px solid #c7d1e4; }
button.plain { background: transparent; color: #254dff; text-align: left; padding: 8px 0; }
button.chip { font-size: 13px; padding: 9px 12px; border-radius: 22px; }
button.selected { background: #254dff; color: #fff; }
button[disabled] { opacity: 0.5; }
.wide { width: 100%; }
.list-item { width: 100%; text-align: left; padding: 18px 0; background: transparent; border-bottom: 1px solid #dde3ef; border-radius: 0; }
.error { background: #fff1e8; color: #85441d; padding: 14px; border-radius: 10px; margin: 14px 0; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 18px; }
.actions button { flex: 1; }
.check { display: flex; align-items: flex-start; gap: 8px; margin: 16px 0; }
.empty { padding: 32px 0; color: #59677e; }
.divider { height: 1px; background: #dde3ef; margin: 20px 0; }
.toolbar { position: sticky; top: 0; z-index: 5; padding: 12px; margin: 12px -4px; border: 1px solid #d7dfed; background: #f4f6fb; border-radius: 12px; }
