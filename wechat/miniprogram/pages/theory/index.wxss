.feedback { color: #24467a; line-height: 1.7; }
.staff { width: 100%; height: 180px; }
.board { margin: 20rpx 0; }
.board-row { display: flex; align-items: stretch; min-height: 88rpx; }
.board-label { width: 28rpx; flex-shrink: 0; align-self: center; }
.board-cell { flex: 1; min-width: 0; text-align: center; border-right: 2rpx solid #a5b2c7; background: #f7f2e9; display: flex; align-items: center; justify-content: center; }
.board-note { padding: 4rpx; margin: 0; min-height: 88rpx; width: 100%; color: #254dff; background: #e9efff; line-height: 1.4; font-size: 28rpx; }
