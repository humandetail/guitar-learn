<view class="page">
  <view class="eyebrow">六弦 · 从第一声开始</view>
  <view class="title">不知道从哪开始？
就从认识这把琴开始。</view>
  <view class="subtitle">14 节课，先认琴、识谱、爬格子，再走向弹唱和指弹。按自己的节奏慢慢来。</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="plain" bindtap="retry">重试{{blocked ? '读取' : '保存'}}</button><button wx:if="{{blocked}}" class="plain" bindtap="reset">重置进度</button></view>
  <view wx:if="{{current}}" class="panel hero">
    <view class="row spread"><text class="badge">已自查 {{count}} / 14 课</text><text class="muted">不需要基础</text></view>
    <view class="h2">{{current.title}}</view><view class="muted">{{current.goal}}</view>
    <button class="primary wide gap" bindtap="resume" disabled="{{blocked}}">{{count || progress.step ? '继续学习' : '开始第一课'}}</button>
  </view>
  <view wx:for="{{groups}}" wx:key="title" wx:for-item="group">
    <view class="h2">{{group.title}}</view>
    <button wx:for="{{group.lessons}}" wx:key="id" class="list-item" bindtap="open" data-id="{{item.id}}" disabled="{{blocked}}">
      <view class="row spread"><text class="h3">{{item.number}}. {{item.title}}</text><text wx:if="{{item.complete}}" class="badge">已自查</text></view>
      <view class="muted">{{item.summary}}</view><view class="muted small">{{item.duration}}</view>
    </button>
  </view>
  <view class="muted small gap">进度保存在当前微信，不与 Web / App 同步。完成自查不代表系统已检测你的演奏。</view>
</view>
